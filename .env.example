# 复制为 .env，chmod 600 .env。用 openssl rand -hex 32 生成主密钥并替换下一行。
# 不要提交或公开 .env，也不要贴出 docker compose config / inspect 的完整输出。
AMS_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# 本机 RX570：999=GPU；改0即可在同机CPU回退。
EMBEDDING_GPU_LAYERS=999
EMBEDDING_CACHE_MIB=256
# 无GPU的CPU主机另改为 /dev/null；需要Linux x86_64及AVX2。
RENDER_DEVICE=/dev/dri/renderD128

# 默认从ghcr.io/qiudeng7/agent-memory-stack-*拉取main标签。
# Actions生成的部署包在这里附加实际GHCR digest，保证四服务版本对应。
